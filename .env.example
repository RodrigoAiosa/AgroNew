# Todas opcionais. Sem elas o app funciona (clima, solo, satélite, PDF, SMS por cópia/atalho).

# Uso comercial do Open-Meteo (https://open-meteo.com/en/pricing)
OPEN_METEO_API_KEY=

# Resposta a SMS recebido (opcional, Twilio): quem está sem internet manda "PULVERIZAR Cidade UF"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=https://seu-app.vercel.app   # usado para validar a assinatura do webhook

# Somente testes/demonstração (dados sintéticos; nunca em produção)
# AGRONEW_DEMO=1
