# Todas opcionais. Sem elas o app funciona (clima, solo, satélite, PDF, SMS por cópia/atalho).

# Uso comercial do Open-Meteo (https://open-meteo.com/en/pricing)
OPEN_METEO_API_KEY=

# Envio de SMS e resposta a SMS recebido (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX            # ou use TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=
SMS_NUMBER=+55 11 90000-0000        # número exibido aos produtores ("mande SMS para ...")
PUBLIC_BASE_URL=https://seu-app.vercel.app   # usado para validar a assinatura do webhook

# Somente testes/demonstração (dados sintéticos; nunca em produção)
# AGROSHIELD_DEMO=1
# AGROSHIELD_DEMO_SCENARIO=good|storm|windy|wet
